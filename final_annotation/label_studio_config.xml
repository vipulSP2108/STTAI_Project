<!-- Label Studio Configuration - Voice Helpdesk ASR (Project 5)
     CS203 Assignment 1

     Step 1: Spoken Languages (English, Hindi, Gujarati) + Transcript
     Step 2: Intent Category (Single choice: admissions, hostel_mess, it_support, student_services)
-->
<View>
  <Header value="Voice Helpdesk Annotation — CS203 Project 5"/>
  <Audio name="audio" value="$audio" zoom="true" hotkey="space"/>

  <!-- STEP 1: Spoken Languages & Transcript -->
  <Header value="Step 1: Spoken Languages &amp; Transcript (fill this FIRST)"/>
  <Choices name="languages" toName="audio" choice="multiple">
    <Choice value="English" hotkey="e" hint="Contains English speech"/>
    <Choice value="Hindi" hotkey="h" hint="Contains Hindi speech (हिन्दी)"/>
    <Choice value="Gujarati" hotkey="g" hint="Contains Gujarati speech (ગુજરાતી)"/>
  </Choices>

  <TextArea
    name="transcript"
    toName="audio"
    placeholder="Type verbatim code-mixed transcript (optional / as needed)"
    rows="3"
    editable="true"
    required="false"
  />

  <!-- STEP 2: Intent -->
  <Header value="Step 2: Intent (fill AFTER Step 1)"/>
  <Choices
    name="intent"
    toName="audio"
    choice="single"
    required="true"
    requiredMessage="Please select one intent category.">
    <Choice value="admissions" hotkey="1"
            hint="Queries about admission process, forms, deadlines, seat availability"/>
    <Choice value="hostel_mess" hotkey="2"
            hint="Queries about hostel rooms, mess food, timings, hostel complaints"/>
    <Choice value="it_support" hotkey="3"
            hint="Queries about WiFi, email/accounts, software, printers, lab PCs"/>
    <Choice value="student_services" hotkey="4"
            hint="Queries about library, health center, transport, student ID cards"/>
  </Choices>
</View>
